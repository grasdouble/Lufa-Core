{
  "extends": "@grasdouble/lufa_config_tsconfig/react-library.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    "paths": {
      "@foundation/*": ["./src/foundation/*"],
      "@content/*": ["./src/content/*"],
      "@interaction/*": ["./src/interaction/*"],
      "@composition/*": ["./src/composition/*"],
      "@utility/*": ["./src/utility/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "exclude": ["dist", "build", "node_modules", "scripts"]
}
