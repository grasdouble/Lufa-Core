# Copy to .env and provide a GitHub Packages read token.
GITHUB_TOKEN=
PORT=3000
# Default: <os.tmpdir()>/cdn-v2. Use a fresh directory when migrating legacy caches.
# CDN_DIR=/var/cache/lufa-cdn-v2
# Forwarding headers are ignored unless actual proxy addresses/CIDRs are listed.
# TRUSTED_PROXIES=127.0.0.1,::1
