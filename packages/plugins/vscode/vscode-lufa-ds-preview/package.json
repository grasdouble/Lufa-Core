{
  "name": "@grasdouble/lufa_plugin_vscode_lufa-ds-preview",
  "displayName": "Lufa DS Preview",
  "version": "0.4.6",
  "private": false,
  "description": "Token previews and decorators for the Lufa design system",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/Lufa.git",
    "directory": "packages/plugins/vscode/vscode-lufa-ds-preview"
  },
  "publisher": "grasdouble",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "pnpm clean && node esbuild.mjs",
    "build-and-install": "pnpm run build && ./scripts/package.sh --install",
    "build-and-no-install": "pnpm run build && ./scripts/package.sh",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "watch": "node esbuild.mjs --watch"
  },
  "contributes": {
    "configuration": {
      "title": "Lufa DS Preview",
      "properties": {
        "lufaDsPreview": {
          "type": "object",
          "description": "Configuration for Lufa DS Preview.",
          "properties": {
            "tokensMapPath": {
              "type": "string",
              "description": "Optional: Path to the tokens map JSON (relative to workspace root or absolute). If not set, the packaged tokens map is used."
            },
            "debug": {
              "type": "boolean",
              "default": false,
              "description": "Enable debug logging for failed color parsing."
            }
          },
          "default": {
            "debug": false
          }
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.ts": [
      "bash -c 'pnpm typecheck'"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grasdouble/lufa_design-system-tokens": "workspace:^",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "workspace:^",
    "@grasdouble/lufa_config_prettier": "workspace:^",
    "@secretlint/secretlint-rule-no-dotenv": "^11.7.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.115.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "sort-package-json": "^3.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
