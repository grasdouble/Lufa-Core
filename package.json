{
  "name": "@grasdouble/lufa",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/lufa.git"
  },
  "scripts": {
    "all:-----------------------------------------------": "",
    "all:build": "pnpm --filter @grasdouble/* run build",
    "all:lint": "pnpm --filter @grasdouble/* run lint",
    "all:prettier:check": "pnpm --filter @grasdouble/* run prettier:check",
    "all:prettier:write": "pnpm --filter @grasdouble/* run prettier:write",
    "all:test": "pnpm --filter @grasdouble/* run test",
    "all:typecheck": "pnpm --filter @grasdouble/* run typecheck",
    "clean": "pnpm clean:node_module && pnpm clean:lib && pnpm clean:cache",
    "clean:----------------------------": "",
    "clean:cache": "pnpm store prune",
    "clean:cache:ts": "pnpm -r exec npx rimraf node_modules/.cache",
    "clean:lib": "pnpm -r exec npx rimraf dist",
    "clean:node_module": "pnpm -r exec npx rimraf node_modules && npx rimraf node_modules",
    "deps:-----------------------------": "",
    "deps:audit": "pnpm -r audit --fix",
    "deps:outdated": "pnpm outdated -r",
    "deps:upgrade": "pnpm update -r && pnpm dedupe",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "sync:-----------------------------": "",
    "sync:agents": "node packages/config/agents/bin/sync-agents.mjs",
    "tools:---------------------------------------------": "",
    "tools:generate-outdated-report": "node .github/actions/dependency-update/generateOutdatedReport.js",
    "validate:------------------------------------------": "",
    "validate:docs": "bash scripts/validate-ai-docs.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'pnpm all:typecheck'"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@grasdouble/lufa_config_eslint": "workspace:^",
    "@grasdouble/lufa_config_prettier": "workspace:^",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "concurrently": "^9.2.3",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "sort-package-json": "^3.7.1"
  },
  "packageManager": "pnpm@11.1.2"
}
